{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "windows-debug",
      "inherits": "windows-base"
    },
    {
      "name": "windows-release",
      "inherits": "windows-base"
    },
    {
      "name": "windows-prebuilt-debug",
      "inherits": "windows-debug",
      "cacheVariables": {
        "QHENKIX_PREBUILT_LIB": "${sourceDir}/prebuilt-qhenkix/QhenkiX/Debug/QhenkiX.lib",
        "QHENKIX_PREBUILT_DIRECTXTEX_LIB": "${sourceDir}/prebuilt-qhenkix/lib/Debug/DirectXTex.lib",
        "QHENKIX_PREBUILT_DIRECTXGUIDS_LIB": "${sourceDir}/prebuilt-qhenkix/DirectX-Headers/Debug/DirectX-Guids.lib",
        "QHENKIX_PREBUILT_SDL_ROOT": "${sourceDir}/prebuilt-qhenkix"
      }
    },
    {
      "name": "windows-prebuilt-release",
      "inherits": "windows-release",
      "cacheVariables": {
        "QHENKIX_PREBUILT_LIB": "${sourceDir}/prebuilt-qhenkix/QhenkiX/Release/QhenkiX.lib",
        "QHENKIX_PREBUILT_DIRECTXTEX_LIB": "${sourceDir}/prebuilt-qhenkix/lib/Release/DirectXTex.lib",
        "QHENKIX_PREBUILT_DIRECTXGUIDS_LIB": "${sourceDir}/prebuilt-qhenkix/DirectX-Headers/Release/DirectX-Guids.lib",
        "QHENKIX_PREBUILT_SDL_ROOT": "${sourceDir}/prebuilt-qhenkix"
      }
    },
    {
      "name": "windows-prebuilt-examples-debug",
      "inherits": "windows-prebuilt-debug",
      "cacheVariables": {
        "SXC_ROOT": "${sourceDir}/prebuilt-sxc"
      }
    },
    {
      "name": "windows-prebuilt-examples-release",
      "inherits": "windows-prebuilt-release",
      "cacheVariables": {
        "SXC_ROOT": "${sourceDir}/prebuilt-sxc"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "QHENKIX_REQUIRED_CLANG_VERSION": "21.1"
      },
      "toolchainFile": "${sourceDir}/QhenkiX/cmake/linux-clang-toolchain.cmake"
    },
    {
      "name": "linux-debug",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-release",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-prebuilt-debug",
      "inherits": "linux-debug",
      "cacheVariables": {
        "QHENKIX_PREBUILT_LIB": "${sourceDir}/prebuilt-qhenkix/QhenkiX/libQhenkiX.a",
        "QHENKIX_PREBUILT_SDL_ROOT": "${sourceDir}/prebuilt-qhenkix"
      }
    },
    {
      "name": "linux-prebuilt-release",
      "inherits": "linux-release",
      "cacheVariables": {
        "QHENKIX_PREBUILT_LIB": "${sourceDir}/prebuilt-qhenkix/QhenkiX/libQhenkiX.a",
        "QHENKIX_PREBUILT_SDL_ROOT": "${sourceDir}/prebuilt-qhenkix"
      }
    },
    {
      "name": "linux-prebuilt-examples-debug",
      "inherits": "linux-prebuilt-debug",
      "cacheVariables": {
        "SXC_ROOT": "${sourceDir}/prebuilt-sxc"
      }
    },
    {
      "name": "linux-prebuilt-examples-release",
      "inherits": "linux-prebuilt-release",
      "cacheVariables": {
        "SXC_ROOT": "${sourceDir}/prebuilt-sxc"
      }
    }
  ]
}
