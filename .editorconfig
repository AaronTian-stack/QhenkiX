root = true

# C++ files
[*.{cpp,h,hpp,cxx,cc,hxx}]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 120

# CMake files
[CMakeLists.txt]
indent_style = space
indent_size = 2
tab_width = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown
[*.md]
trim_trailing_whitespace = false
insert_final_newline = true
indent_style = space
indent_size = 2

# YAML/Config
[*.{yml,yaml,json}]
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
